SELECT COUNT(*) AS n, SUM((a.id+1)*(b.id+3)*STRCMP(a.v,b.v)) AS comparison_checksum FROM ascii_bytes a CROSS JOIN ascii_bytes b;
n	comparison_checksum
16384	657460
SELECT COUNT(*) AS n, SUM((a.id+1)*(b.id+3)*STRCMP(CONCAT('common-prefix-',a.v),CONCAT('common-prefix-',b.v))) AS comparison_checksum FROM ascii_bytes a CROSS JOIN ascii_bytes b;
n	comparison_checksum
16384	657460
