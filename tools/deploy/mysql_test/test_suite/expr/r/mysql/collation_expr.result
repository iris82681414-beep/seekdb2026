(1, '', ''), (2, 'a', 'a'), (3, 'a', 'A'), (4, 'é', 'e'),
(5, 'a', 'a '), (6, '', ' '),
(7, concat('a', char(0), 'b'), concat('a', char(0), 'b')),
(8, repeat('x', 63), repeat('x', 63)),
(9, repeat('x', 64), repeat('x', 64)),
(10, repeat('x', 65), repeat('x', 65)),
(11, concat(repeat('x', 63), 'a'), concat(repeat('x', 63), 'b')),
(12, concat(repeat('x', 64), 'a'), concat(repeat('x', 64), 'b')),
(13, repeat('数', 21), repeat('数', 21)),
