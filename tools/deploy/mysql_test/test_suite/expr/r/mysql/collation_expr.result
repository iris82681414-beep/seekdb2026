prepare short_key_compare from 'select id, a = ? as eq from short_comparison_keys where id in (2, 3, 5, 9, 18) order by id';
set @short_key = 'A';
execute short_key_compare using @short_key;
id	eq
2	1
3	1
5	1
9	0
18	0
set @short_key = repeat('x', 64);
execute short_key_compare using @short_key;
id	eq
2	0
3	0
5	0
9	1
18	0
deallocate prepare short_key_compare;
drop table short_comparison_keys;
create table ready_collation_keys (
id int primary key,
general_key varchar(128) collate utf8mb4_general_ci,
unicode_key varchar(128) collate utf8mb4_unicode_ci,
binary_key varchar(128) collate utf8mb4_bin,
raw_key varbinary(128)
);
insert into ready_collation_keys (id, general_key) values
(1, ''), (2, 'a'), (3, 'A'), (4, 'a '), (5, 'é'), (6, 'e'),
(7, 'ß'), (8, 'ss'), (9, '数据库'), (10, '数据仓'),
(11, concat('a', char(0), 'b')), (12, null);
update ready_collation_keys set unicode_key=general_key, binary_key=general_key, raw_key=general_key;
select id, general_key='a' as g, unicode_key='a' as u,
binary_key='a' as b, raw_key=_binary'a' as r from ready_collation_keys order by id;
