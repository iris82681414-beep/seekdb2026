drop table if exists coll_test;
create table coll_test(pk bigint primary key, uc varchar(10) collate utf8mb4_general_ci, ub varchar(10) collate utf8mb4_bin, b varbinary(10));
show create table coll_test;
Table	Create Table
coll_test	CREATE TABLE `coll_test` (
  `pk` bigint(20) NOT NULL,
  `uc` varchar(10) DEFAULT NULL,
  `ub` varchar(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL,
  `b` varbinary(10) DEFAULT NULL,
  PRIMARY KEY (`pk`)
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = SIZE TABLET_SIZE = SIZE PCTFREE = 10
