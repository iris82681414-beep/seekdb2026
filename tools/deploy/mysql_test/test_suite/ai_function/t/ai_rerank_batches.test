connection default;
--exec python3 mysql_test/test_suite/ai_function/include/ai_rerank_mock.py start 19130
--disable_query_log
--disable_result_log
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('batch_rerank_ep');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('batch_rerank');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('batch_rerank', '{"type":"rerank","model_name":"fixture"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('batch_rerank_ep', '{"ai_model_name":"batch_rerank","url":"http://127.0.0.1:19130/siliconflow","access_key":"synthetic-fixture","provider":"siliconflow"}');
set @documents='["doc:0","doc:1","doc:2","doc:3","doc:4","doc:5","doc:6","doc:7","doc:8","doc:9","doc:10","doc:11","doc:12","doc:13","doc:14","doc:15","doc:16","doc:17","doc:18","doc:19","doc:20","doc:21","doc:22","doc:23","doc:24","doc:25","doc:26","doc:27","doc:28","doc:29","doc:30","doc:31","doc:32","doc:33","doc:34","doc:35","doc:36","doc:37","doc:38","doc:39","doc:40","doc:41","doc:42","doc:43","doc:44","doc:45"]';
set @objects='[{"id":0,"text":"doc:0","extra":{"keep":true}},{"id":1,"text":"doc:1","extra":{"keep":true}},{"id":2,"text":"doc:2","extra":{"keep":true}},{"id":3,"text":"doc:3","extra":{"keep":true}},{"id":4,"text":"doc:4","extra":{"keep":true}},{"id":5,"text":"doc:5","extra":{"keep":true}},{"id":6,"text":"doc:6","extra":{"keep":true}},{"id":7,"text":"doc:7","extra":{"keep":true}},{"id":8,"text":"doc:8","extra":{"keep":true}},{"id":9,"text":"doc:9","extra":{"keep":true}},{"id":10,"text":"doc:10","extra":{"keep":true}},{"id":11,"text":"doc:11","extra":{"keep":true}},{"id":12,"text":"doc:12","extra":{"keep":true}},{"id":13,"text":"doc:13","extra":{"keep":true}},{"id":14,"text":"doc:14","extra":{"keep":true}},{"id":15,"text":"doc:15","extra":{"keep":true}},{"id":16,"text":"doc:16","extra":{"keep":true}},{"id":17,"text":"doc:17","extra":{"keep":true}},{"id":18,"text":"doc:18","extra":{"keep":true}},{"id":19,"text":"doc:19","extra":{"keep":true}},{"id":20,"text":"doc:20","extra":{"keep":true}},{"id":21,"text":"doc:21","extra":{"keep":true}},{"id":22,"text":"doc:22","extra":{"keep":true}},{"id":23,"text":"doc:23","extra":{"keep":true}},{"id":24,"text":"doc:24","extra":{"keep":true}},{"id":25,"text":"doc:25","extra":{"keep":true}},{"id":26,"text":"doc:26","extra":{"keep":true}},{"id":27,"text":"doc:27","extra":{"keep":true}},{"id":28,"text":"doc:28","extra":{"keep":true}},{"id":29,"text":"doc:29","extra":{"keep":true}},{"id":30,"text":"doc:30","extra":{"keep":true}},{"id":31,"text":"doc:31","extra":{"keep":true}},{"id":32,"text":"doc:32","extra":{"keep":true}},{"id":33,"text":"doc:33","extra":{"keep":true}},{"id":34,"text":"doc:34","extra":{"keep":true}},{"id":35,"text":"doc:35","extra":{"keep":true}},{"id":36,"text":"doc:36","extra":{"keep":true}},{"id":37,"text":"doc:37","extra":{"keep":true}},{"id":38,"text":"doc:38","extra":{"keep":true}},{"id":39,"text":"doc:39","extra":{"keep":true}},{"id":40,"text":"doc:40","extra":{"keep":true}},{"id":41,"text":"doc:41","extra":{"keep":true}},{"id":42,"text":"doc:42","extra":{"keep":true}},{"id":43,"text":"doc:43","extra":{"keep":true}},{"id":44,"text":"doc:44","extra":{"keep":true}},{"id":45,"text":"doc:45","extra":{"keep":true}}]';
set @r=ai_rerank('batch_rerank', 'ascending', @documents, null);
--enable_result_log
--enable_query_log
select json_length(@r) = 46 and json_extract(@r, '$[0].index') = 45 and json_extract(@r, '$[45].index') = 0 as complete_global_order;
--disable_query_log
set @r=ai_rerank('batch_rerank', 'tie', @documents);
--enable_query_log
select json_extract(@r, '$[0].index') = 0 and json_extract(@r, '$[20].index') = 20 and json_extract(@r, '$[45].index') = 45 as stable_ties;
--disable_query_log
set @r=ai_rerank('batch_rerank', 'ascending', @objects, 'text');
--enable_query_log
select json_length(@r) = 46 and json_extract(@r, '$[0].id') = 45 and json_extract(@r, '$[0].extra.keep') = true and json_extract(@r, '$[45]._model_score') = 0.25 as object_payload_preserved;
--disable_query_log
--disable_result_log
drop table if exists rerank_lobs;
create table rerank_lobs(q longtext, k text);
insert into rerank_lobs values(repeat('query',10000),'text');
--enable_result_log
--enable_query_log
select json_length(ai_rerank('batch_rerank',q,@objects,k)) = 46 as lob_query_and_key from rerank_lobs;
--disable_query_log
--disable_result_log
drop table rerank_lobs;
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('batch_rerank_ep', '{"provider":"aliyun-dashscope","url":"http://127.0.0.1:19130/dashscope"}');
set @r=ai_rerank('batch_rerank', 'ascending', @documents);
--enable_result_log
--enable_query_log
select json_length(@r) = 46 and json_extract(@r, '$[0].index') = 45 as dashscope_batch_order;
--disable_query_log
--disable_result_log
--error 4070
select ai_rerank('batch_rerank', 'missing', @documents);
--error 4070
select ai_rerank('batch_rerank', 'duplicate', @documents);
--error 4070
select ai_rerank('batch_rerank', 'negative', @documents);
--error 4070
select ai_rerank('batch_rerank', 'large', @documents);
--error 4070
select ai_rerank('batch_rerank', 'float-index', @documents);
--error 4070
select ai_rerank('batch_rerank', 'boolean-index', @documents);
--error 4070
select ai_rerank('batch_rerank', 'string-score', @documents);
--error 4070
select ai_rerank('batch_rerank', 'boolean-score', @documents);
--error 4070
select ai_rerank('batch_rerank', 'null-score', @documents);
--error 4070
select ai_rerank('batch_rerank', 'missing-score', @documents);
--error 4070
select ai_rerank('batch_rerank', 'wrong-item', @documents);
--error 4070
select ai_rerank('batch_rerank', 'wrong-results', @documents);
--error 4070
select ai_rerank('batch_rerank', 'wrong-output', @documents);
--error 4070
select ai_rerank('batch_rerank', 'wrong-root', @documents);
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('batch_rerank_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('batch_rerank');
--exec python3 mysql_test/test_suite/ai_function/include/ai_rerank_mock.py stop 19130
