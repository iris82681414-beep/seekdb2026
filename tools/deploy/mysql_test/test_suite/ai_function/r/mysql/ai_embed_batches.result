select count(*) = 46 and sum(v is null) = 3 and sum(if(content is not null, cast(json_extract(v,'$[0]') as signed) = id + if(model='batch_embed_b',10000,0),0)) = 43 and sum(if(content is not null,json_length(v) = dim,0)) = 43 as mixed_groups_and_nulls from (select id,model,content,dim,ai_embed(model,content,dim) as v from embed_batch_rows) x;
