# owner: database-competition
# description: Native File SQL filters, joins, rescans, and atomic CSV COPY.
--source mysql_test/test_suite/file_sql/include/copy_file_sql_data.inc
--disable_query_log
let $FILE_SQL_DATA_DIR = $OBSERVER_DIR/data_for_mysqltest_file_sql;
set session enable_file_sql = ON;
--disable_warnings
drop table if exists file_sql_weights;
--enable_warnings

--echo # filter, expression, order, and LIMIT retain original rows
eval select id, upper(name) AS name from read_csv('$FILE_SQL_DATA_DIR/basic.csv') where score > 90 order by id desc limit 1;
eval select count(*) AS rows_found from read_ndjson('$FILE_SQL_DATA_DIR/basic.jsonl');

--echo # NUL in a JSON field name is rejected before exposing SQL metadata
--disable_result_log
--error 1210
eval select * from read_json('$FILE_SQL_DATA_DIR/nul-column-name.jsonl');
--error 1210
eval describe select * from read_ndjson('$FILE_SQL_DATA_DIR/nul-column-name.jsonl');
--enable_result_log

--echo # native CSV/JSON and CSV/Parquet joins
eval select count(*) AS matched, sum(c.id) AS id_sum from read_csv('$FILE_SQL_DATA_DIR/basic.csv') c join read_json('$FILE_SQL_DATA_DIR/basic.jsonl') j on c.id = j.id;
eval select count(*) AS pairs, sum(c.id) AS csv_sum, sum(p.c1) AS parquet_sum from read_csv('$FILE_SQL_DATA_DIR/basic.csv') c cross join read_parquet('$FILE_SQL_DATA_DIR/simple.parquet') p;

--echo # join seekdb table; nested loop can restart its file cursor
create table file_sql_weights (id bigint primary key, weight bigint);
insert into file_sql_weights values (1,10),(3,30),(4,40);
eval select /*+ leading(w c) use_nl(c) */ w.id, c.name, w.weight from file_sql_weights w join read_csv('$FILE_SQL_DATA_DIR/basic.csv') c on c.id = w.id order by w.id;
eval select count(*) AS csv_rows, count(w.weight) AS matches, sum(w.weight) AS weight_sum from read_csv('$FILE_SQL_DATA_DIR/basic.csv') c left join file_sql_weights w on c.id = w.id;

--echo # COPY table and query retain expressions, quoted data, and NULLs
eval copy file_sql_weights to '$FILE_SQL_DATA_DIR/weights.csv' (format csv, header);
eval select id, weight from read_csv('$FILE_SQL_DATA_DIR/weights.csv') order by id;
eval copy (select id, name, note, day from read_csv('$FILE_SQL_DATA_DIR/basic.csv') order by id desc limit 2) to '$FILE_SQL_DATA_DIR/quoted.csv' (header true, delimiter '|', nullstr 'NULL');
eval select id, name, replace(note,char(10),'<NL>') AS note, day from read_csv('$FILE_SQL_DATA_DIR/quoted.csv', delimiter='|',nullstr='NULL') order by id;
--disable_result_log
--error 1086
eval copy (select 0 AS id) to '$FILE_SQL_DATA_DIR/weights.csv' (header);
--enable_result_log
eval select sum(weight) AS unchanged_sum from read_csv('$FILE_SQL_DATA_DIR/weights.csv');

--echo # empty COPY produces a valid header without phantom data
eval copy (select id from file_sql_weights where 0) to '$FILE_SQL_DATA_DIR/empty.csv' (header);
eval select count(*) AS empty_count from read_csv('$FILE_SQL_DATA_DIR/empty.csv');

--echo # query errors remove temporary and destination files
--disable_result_log
--error 3141
eval copy (select id, case when id < 3 then name else cast(json_extract(concat('{',id),char(36)) as char) end AS name from read_csv('$FILE_SQL_DATA_DIR/basic.csv') order by id) to '$FILE_SQL_DATA_DIR/failed.csv' (header);
--enable_result_log
eval select count(*) AS failed_targets from glob('$FILE_SQL_DATA_DIR/failed.csv');
eval select count(*) AS temporary_files from glob('$FILE_SQL_DATA_DIR/.seekdb-copy-*');

--echo # bounded glob preserves wildcard, literal, and hidden-file semantics
eval select substring_index(file,'/',-1) AS file from glob('$FILE_SQL_DATA_DIR/[bq]*.csv') order by file;
eval select count(*) AS literal_match from glob('$FILE_SQL_DATA_DIR/weights.csv');
eval select count(*) AS literal_missing from glob('$FILE_SQL_DATA_DIR/missing.csv');
eval copy (select 1 AS id) to '$FILE_SQL_DATA_DIR/.hidden.csv' (header);
eval select count(*) AS visible_files from glob('$FILE_SQL_DATA_DIR/*');
eval select count(*) AS hidden_files from glob('$FILE_SQL_DATA_DIR/.*.csv');

--disable_result_log
--error 1054
eval select nonexistent from read_csv('$FILE_SQL_DATA_DIR/basic.csv');
--enable_result_log
drop table file_sql_weights;
set session enable_file_sql = OFF;
--disable_result_log
--error 1235
eval copy (select 1) to '$FILE_SQL_DATA_DIR/disabled.csv';
--enable_result_log
--enable_query_log
--source mysql_test/test_suite/file_sql/include/remove_file_sql_data.inc
