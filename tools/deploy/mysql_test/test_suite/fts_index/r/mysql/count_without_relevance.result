DROP DATABASE IF EXISTS fts_count_score;
CREATE DATABASE fts_count_score;
USE fts_count_score;
CREATE TABLE t_count_space(id INT PRIMARY KEY, doc VARCHAR(200), FULLTEXT INDEX i1(doc) WITH PARSER space);
INSERT INTO t_count_space VALUES (1, 'apple banana'), (2, 'apple cherry'), (3, 'apple'), (4, 'banana banana'), (5, 'durian');
SELECT COUNT(*) AS hits FROM t_count_space WHERE MATCH (doc) AGAINST ('apple');
hits
3
SELECT COUNT(*) AS hits FROM t_count_space WHERE MATCH (doc) AGAINST ('apple') > 1e-9;
hits
3
SELECT COUNT(*) AS hits FROM t_count_space WHERE MATCH (doc) AGAINST ('apple banana');
hits
4
SELECT COUNT(*) AS hits FROM t_count_space WHERE MATCH (doc) AGAINST ('apple banana') > 1e-9;
hits
4
SELECT COUNT(*) AS hits FROM t_count_space WHERE MATCH (doc) AGAINST ('missing');
hits
0
SELECT COUNT(*) AS hits FROM t_count_space WHERE MATCH (doc) AGAINST ('missing') > 1e-9;
hits
0
SELECT COUNT(*) AS hits FROM t_count_space WHERE MATCH (doc) AGAINST ('apple banana') > 0;
hits
4
SELECT COUNT(DISTINCT id) AS hits FROM t_count_space WHERE MATCH (doc) AGAINST ('apple banana');
hits
4
SELECT COUNT(*) AS hits FROM t_count_space WHERE MATCH (doc) AGAINST ('+apple -banana' IN BOOLEAN MODE);
hits
2
SELECT id FROM t_count_space WHERE MATCH (doc) AGAINST ('apple banana') ORDER BY id;
id
1
2
3
4
CREATE TABLE t_count_ngram(id INT PRIMARY KEY, doc VARCHAR(200), FULLTEXT INDEX i1(doc) WITH PARSER ngram);
INSERT INTO t_count_ngram VALUES (1, 'distributed database'), (2, 'disaster recovery'), (3, 'financial industry'), (4, '测试数据');
SELECT COUNT(*) AS hits FROM t_count_ngram WHERE MATCH (doc) AGAINST ('OceanBase Database is a native, enterprise-level distributed database developed independently by the OceanBase team. It provides financial-grade high availability on commodity hardware and introduces a new city-level disaster recovery standard known as Five IDCs across Three Regions. As the worlds first distributed database to pass the TPC-C benchmark test, it can support over 1,500 nodes in a single cluster. Additionally, it features cloud-native architecture, strong consistency, and high compatibility with other popular databases such as MariaDB and MySQL.  OceanBase Database implements a unique disaster recovery solution with five IDCs across three regions, which sets forth a new standard for lossless disaster recovery in the financial industry. OceanBase Database supports multi-active IDCs deployed across multiple regions for zone- and geo-disaster recovery, which meets the Level 6 disaster recovery requirements of the financial industry with a recovery point objective (RPO) of 0 and a recovery time objective (RTO) of less than 8 seconds.');
hits
3
SELECT COUNT(*) AS hits FROM t_count_ngram WHERE MATCH (doc) AGAINST ('OceanBase Database is a native, enterprise-level distributed database developed independently by the OceanBase team. It provides financial-grade high availability on commodity hardware and introduces a new city-level disaster recovery standard known as Five IDCs across Three Regions. As the worlds first distributed database to pass the TPC-C benchmark test, it can support over 1,500 nodes in a single cluster. Additionally, it features cloud-native architecture, strong consistency, and high compatibility with other popular databases such as MariaDB and MySQL.  OceanBase Database implements a unique disaster recovery solution with five IDCs across three regions, which sets forth a new standard for lossless disaster recovery in the financial industry. OceanBase Database supports multi-active IDCs deployed across multiple regions for zone- and geo-disaster recovery, which meets the Level 6 disaster recovery requirements of the financial industry with a recovery point objective (RPO) of 0 and a recovery time objective (RTO) of less than 8 seconds.') > 1e-9;
hits
3
DROP DATABASE fts_count_score;
