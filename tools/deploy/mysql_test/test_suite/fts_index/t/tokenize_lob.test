# TOKENIZE must read TEXT/LOB contents rather than their internal locators.
--disable_warnings
DROP DATABASE IF EXISTS tokenize_lob_regression;
--enable_warnings
CREATE DATABASE tokenize_lob_regression;
USE tokenize_lob_regression;
CREATE TABLE docs (id INT PRIMARY KEY, body TEXT, parser_name TEXT, props TEXT) LOB_INROW_THRESHOLD=4096;
INSERT INTO docs VALUES (1,'alpha beta alpha','space','[{"output":"all"}]'),(2,'','space','[{"output":"all"}]'),(3,NULL,NULL,'[{"output":"all"}]');
SELECT id,JSON_LENGTH(TOKENIZE(body,'beng')) AS unique_words FROM docs ORDER BY id;
SELECT id,TOKENIZE(body,parser_name,props)=TOKENIZE(CAST(body AS CHAR),CAST(parser_name AS CHAR),CAST(props AS CHAR)) AS same_result FROM docs ORDER BY id;
SELECT JSON_EXTRACT(TOKENIZE(body,parser_name,props),'$.doc_len') AS doc_len FROM docs WHERE id=1;
SELECT JSON_CONTAINS(JSON_EXTRACT(TOKENIZE(body,parser_name,props),'$.tokens'),'{"alpha":2}') AS alpha_count,JSON_CONTAINS(JSON_EXTRACT(TOKENIZE(body,parser_name,props),'$.tokens'),'{"beta":1}') AS beta_count FROM docs WHERE id=1;

# Both the content and whitespace-padded parser name now exceed the threshold.
UPDATE docs SET body=REPEAT('alpha beta ',1200),parser_name=CONCAT(REPEAT(' ',6000),'space',REPEAT(' ',6000)) WHERE id=1;
SELECT JSON_EXTRACT(TOKENIZE(body,parser_name,props),'$.doc_len') AS doc_len,JSON_LENGTH(JSON_EXTRACT(TOKENIZE(body,parser_name,props),'$.tokens')) AS unique_words FROM docs WHERE id=1;
SELECT JSON_CONTAINS(JSON_EXTRACT(TOKENIZE(body,parser_name,props),'$.tokens'),'{"alpha":1200}') AS alpha_count,JSON_CONTAINS(JSON_EXTRACT(TOKENIZE(body,parser_name,props),'$.tokens'),'{"beta":1200}') AS beta_count FROM docs WHERE id=1;
CREATE TABLE outrow_docs (id INT PRIMARY KEY, body LONGTEXT, parser_name TEXT, props TEXT) LOB_INROW_THRESHOLD=0;
INSERT INTO outrow_docs SELECT * FROM docs;
SELECT id,TOKENIZE(body,parser_name,props)=TOKENIZE(CAST(body AS CHAR),CAST(parser_name AS CHAR),CAST(props AS CHAR)) AS same_result FROM outrow_docs ORDER BY id;
UPDATE outrow_docs SET body=REPEAT('数据库 ',1500),parser_name='ik' WHERE id=1;
SELECT TOKENIZE(body,parser_name,props)=TOKENIZE(CAST(body AS CHAR),'ik',CAST(props AS CHAR)) AS same_chinese_result FROM outrow_docs WHERE id=1;
UPDATE outrow_docs SET parser_name=NULL WHERE id=1;
SELECT TOKENIZE('alpha beta',parser_name)=TOKENIZE('alpha beta') AS default_parser FROM outrow_docs WHERE id=1;
UPDATE outrow_docs SET parser_name='' WHERE id=1;
--error 1210
SELECT TOKENIZE('alpha beta',parser_name) FROM outrow_docs WHERE id=1;
DROP DATABASE tokenize_lob_regression;
