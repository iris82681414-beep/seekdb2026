cc_test(
    name = "test_fts_token_pipeline",
    size = "small",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [":fts_token_pipeline_cases", "//src/observer:liboceanbase"],
    target_compatible_with = ["@platforms//os:linux"],
